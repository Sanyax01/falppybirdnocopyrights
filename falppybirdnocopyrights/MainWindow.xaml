<Window x:Class="falppybirdnocopyrights.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:falppybirdnocopyrights"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Canvas x:Name="GameCanvas" Background="LightBlue" Margin="0,58,0,0">
            <Rectangle x:Name="Bird" Width="30" Height="30" Fill="Yellow" Canvas.Left="100" Canvas.Top="200"/>
            <Rectangle x:Name="PipeTop" Width="50" Height="200" Fill="Green" Canvas.Left="400" Canvas.Top="0"/>
            <Rectangle x:Name="PipeBottom" Width="50" Height="200" Fill="Green" Canvas.Left="400" Canvas.Top="300"/>
        </Canvas>
        <Button Content="Start" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Height="43" Width="200" Click="Start"/>
        <Button Content="Sima" Margin="225,9,399,381" Click="Sima"/>
        <Button Content="Esős" Margin="406,9,218,381" Click="Esos"/>
        <Button Content="Ködös" Margin="587,10,37,380" Click="Kodos"/>
    </Grid>
</Window>
