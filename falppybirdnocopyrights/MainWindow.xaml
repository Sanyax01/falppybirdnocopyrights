<Window x:Class="falppybirdnocopyrights.MainWindow"
        PreviewKeyDown="SpaceJump"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:falppybirdnocopyrights"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Canvas x:Name="GameCanvas" Background="LightBlue" Margin="0,58,0,0">
            <Rectangle x:Name="Bird"   Width="30" Height="30" Canvas.Left="100" Canvas.Top="200">
                <Rectangle.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#FF070A9E" Offset="0.439"/>
                        <GradientStop Color="#FFFF1FD8" Offset="1"/>
                        <GradientStop Color="#FF0C0FFF" Offset="0.5"/>
                        <GradientStop Color="#FFD9E411" Offset="0"/>
                        <GradientStop Color="#FFF3FF00" Offset="0.183"/>
                        <GradientStop Color="#FF747908" Offset="0.419"/>
                    </RadialGradientBrush>
                </Rectangle.Fill>

            </Rectangle>
            <Rectangle x:Name="PipeTop" Width="50" Height="200" Fill="Green" Canvas.Left="400" Canvas.Top="0"/>
            <Rectangle x:Name="PipeBottom" Width="50" Height="200" Fill="Green" Canvas.Left="400" Canvas.Top="300"/>
        </Canvas>
        <Button Content="Start" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Height="43" Width="200" Click="Start"/>
        <Button Content="Sima" HorizontalAlignment="Left" Margin="220,10,0,0" VerticalAlignment="Top" Height="43" Width="170" Click="Sima"/>
        <Button x:Name="esos" Content="Esős" HorizontalAlignment="Left" Margin="400,10,0,0" VerticalAlignment="Top" Height="43" Width="170" Click="Esos"/>
        <Button Content="Ködös" HorizontalAlignment="Left" Margin="580,10,0,0" VerticalAlignment="Top" Height="43" Width="170" Click="Kodos"/>
        <Button x:Name="jump" HorizontalAlignment="Left" Margin="755,32,0,0" VerticalAlignment="Top" Height="20" Width="45" Click="SpaceJump" BorderBrush="White" Background="White"/>
    </Grid>
</Window>
